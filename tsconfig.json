{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "Fixtures/**/*",
    "Flows/**/*",
    "Helpers/**/*",
    "tests-playwright/**/*",
    "playwright.config.ts"
  ]
}
